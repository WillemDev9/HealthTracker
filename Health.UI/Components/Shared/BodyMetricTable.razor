<table class="table table-striped table-hover mt-4">
    <tr>
        <th>Date</th>
        <th>Weight (lbs)</th>
        <th>Narrow Waist (in)</th>
        <th>Navel Waist (in)</th>
        <th>Hips (in)</th>
        <th>Chest (in)</th>
        <th>Shoulders (in)</th>
        <th>Biceps (in)</th>
        <th>Forearms (in)</th>
        <th>Thighs (in)</th>
        <th>Calves (in)</th>
    </tr>

    @foreach(BodyMetricLog log in BodyMetrics)
    {
        <tr>
            <td>@log.Date</td>
            <td>@log.Weight</td>
            <td>@log.WaistNarrow</td>
            <td>@log.WaistNavel</td>
            <td>@log.Hips</td>
            <td>@log.Chest</td>
            <td>@log.Shoulders</td>
            <td>@log.Biceps</td>
            <td>@log.Forearms</td>
            <td>@log.Thighs</td>
            <td>@log.Calves</td>
            <td>
                <button class="btn btn-secondary" @onclick="() => OnDeleteClicked.InvokeAsync(log)">X</button>
            </td>
        </tr>
    }
</table>

@code
{
    [Parameter]
    public List<BodyMetricLog> BodyMetrics {get;set;} = new();
    [Parameter]
    public EventCallback<BodyMetricLog> OnDeleteClicked {get;set;}
}